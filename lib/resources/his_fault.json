                                "type": "metadata",
                                "content": "fact"
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Well, I had to work late.\""
                            }
                        ]
                    },
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Yes, I know, but my chest is tightening up talking about this. "
