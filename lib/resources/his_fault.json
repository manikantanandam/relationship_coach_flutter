                "title": "Real Life Example 1:",
                "scenario": "He said he'd call, but didn't",
                "dialogue": [
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"I felt sad "
                            },
