                                "type": "text",
                                "content": "\"Well, you're right. I should have called you. I'm sorry. I'll try to be more conscious of it.\""
                            }
                        ]
                    },
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Help me understand what you mean when you say that.\" "
                            },
                            {
                                "type": "metadata",
                                "content": "clarification"
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Well, I will call you when I say I will.\""
                            }
                        ]
                    },
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Thank you. I appreciate you so much.\" "
                            },
                            {
                                "type": "metadata",
                                "content": "appreciation"
                            }
                        ]
                    }
                ]
