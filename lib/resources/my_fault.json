                "title": "Real Life Example 1:",
                "dialogue": [
                    {
                        "speaker": "She",
                        "segments": [
                            {
                                "type": "text",
                                "value": "\"You didn't pay any attention to me at the party.\""
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "segments": [
                            {
                                "type": "text",
                                "value": "\"You're right. I didn't pay attention to you at the party "
                            },
                            {
                                "type": "metadata",
                                "value": "admit"
                            },
                            {
                                "type": "text",
                                "value": " and I'm very sorry. "
                            },
                            {
                                "type": "metadata",
                                "value": "apologize"
                            },
                            {
                                "type": "text",
                                "value": " Thank you for sharing that with me and not hiding your feelings. "
                            },
                            {
                                "type": "metadata",
                                "value": "appreciation"
                            },
                            {
                                "type": "text",
                                "value": " I commit to not doing that again. "
                            },
                            {
                                "type": "metadata",
                                "value": "commit-to-change"
                            },
                            {
                                "type": "text",
                                "value": " Would you please forgive me?\" "
                            },
                            {
                                "type": "metadata",
                                "value": "ask forgiveness"
                            }
                        ]
                    },
                    {
                        "speaker": "She",
                        "segments": [
                            {
                                "type": "text",
                                "value": "\"Ok, I forgive you.\""
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "segments": [
