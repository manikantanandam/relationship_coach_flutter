            {
                "id": 1,
                "title": "Real Life Example 1:",
                "dialogue": [
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"I'm irritated that I have to pick you up because your car broke down and you're never ready when I get here.\""
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"You're right. I haven't been ready on time. "
                            },
