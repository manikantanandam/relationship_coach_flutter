                                "type": "metadata",
                                "content": "body feeling"
                            },
                            {
                                "type": "text",
                                "content": " I don't like feeling this way.\" "
                            },
                            {
                                "type": "metadata",
                                "content": "negative self-feeling statement"
                            }
                        ]
                    },
                    {
                        "speaker": "She",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"Well, you're just a piece of trash!\""
                            }
                        ]
                    },
                    {
                        "speaker": "He",
                        "parts": [
                            {
                                "type": "text",
                                "content": "\"You can talk to me any way you want, "
                            },
                            {
                                "type": "metadata",
                                "content": "give permission"
                            },
                            {
                                "type": "text",
                                "content": " but hearing that makes me need to leave.\" "
                            },
                            {
                                "type": "metadata",
                                "content": "take your feelings for a walk"
                            }
                        ]
                    }
                ]
